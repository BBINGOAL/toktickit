// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────
enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMIN
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Reference Tables ─────────────────────────────────────
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ─── User (New in Lab 3) ──────────────────────────────────
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String // เก็บพาสเวิร์ดที่เข้ารหัสแล้ว
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true) // บังคับเปลี่ยนรหัสผ่านครั้งแรก
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  ticketsOwned    Ticket[]        @relation("TicketRequester")
  ticketsAssigned Ticket[]        @relation("TicketOwner")
  attachments     Attachment[]
  publicComments  PublicComment[]
  internalNotes   InternalNote[]
  actionsPerformed ActionTaken[] @relation("ActionPerformer")
  actionsAssigned ActionTaken[] @relation("ActionAssignee")
  actionEvents ActionTakenEvent[]
  workflowEvents TicketWorkflowEvent[]
  mutationRequests MutationRequest[]
}

// ─── Ticket ───────────────────────────────────────────────
model Ticket {
  id                  Int             @id @default(autoincrement())
  ticketNumber        String          @unique
  requesterId         Int
  categoryId          Int
  relatedSystemId     Int
  summary             String
  description         String
  requestedPriority   Priority
  itPriority          Priority?
  status              TicketStatus    @default(NEW)
  ownerId             Int? // ชี้ไปหาพนักงาน IT (User)
  resolutionSummary   String?
  requesterResolved   Boolean         @default(false)
  requesterResolvedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  version             Int             @default(0)
  workCycle           Int             @default(1)
  resolvedAt          DateTime?
  cancelledReason     String?
  // Relations
  requester           User            @relation("TicketRequester", fields: [requesterId], references: [id])
  owner               User?           @relation("TicketOwner", fields: [ownerId], references: [id])
  category            Category        @relation(fields: [categoryId], references: [id])
  relatedSystem       RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments         Attachment[]
  comments            PublicComment[]
  notes               InternalNote[]
  actions             ActionTaken[]
  workflowEvents      TicketWorkflowEvent[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([status])
  @@index([requesterId, status])
  @@index([ownerId, status])
  @@index([itPriority, status])
  @@index([updatedAt, id])
  @@index([resolvedAt])
}

model ActionTaken {
  id Int @id @default(autoincrement())
  ticketId Int
  workCycle Int
  actionDateTime DateTime
  description String
  result String @default("")
  performedById Int
  assigneeId Int
  followUpRequired Boolean @default(false)
  followUpNote String @default("")
  attachmentNotes String @default("")
  followsUpActionId Int?
  status ActionStatus @default(PLANNED)
  cancellationReason String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee User @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  followsUpAction ActionTaken? @relation("ActionFollowUp", fields: [followsUpActionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  followUps ActionTaken[] @relation("ActionFollowUp")
  events ActionTakenEvent[]
  @@index([ticketId, workCycle, actionDateTime, id])
  @@index([assigneeId, status, updatedAt, id])
  @@index([followsUpActionId])
}

model ActionTakenEvent {
  id Int @id @default(autoincrement())
  actionId Int
  actorId Int
  kind String
  before Json?
  after Json
  createdAt DateTime @default(now())
  action ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actionId, createdAt, id])
}

model TicketWorkflowEvent {
  id Int @id @default(autoincrement())
  ticketId Int
  actorId Int
  kind String
  before Json?
  after Json
  workCycle Int
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
}

model MutationRequest {
  id Int @id @default(autoincrement())
  userId Int
  scope String
  key String
  payloadDigest String
  responseStatus Int
  response Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, scope, key])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String
  ticketId  Int
  authorId  Int
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

// ─── Attachment ───────────────────────────────────────────
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  uploadedById     Int
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?
  createdAt        DateTime  @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([isRemoved])
}
